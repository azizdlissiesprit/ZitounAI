# Copy to .env (never commit .env):   cp .env.example .env
DB_USER=zitouna
DB_PASSWORD=zitouna
# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Host ports (change them if another program already uses one, e.g. a local PostgreSQL or Oracle on 8080)
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200
